<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.dotfiles.cleanup-desktop</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/cleanup-desktop.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/cleanup-desktop-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/cleanup-desktop-stderr.log</string>
</dict>
</plist>
