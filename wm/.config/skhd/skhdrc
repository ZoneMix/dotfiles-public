# A list of all built-in modifier and literal keywords can
# be found at https://github.com/koekeishiya/skhd/issues/1


# focus window
cmd + shift - h : yabai -m window --focus west;
cmd + shift - l : yabai -m window --focus east;
cmd + shift - k : yabai -m window --focus north;
cmd + shift - j : yabai -m window --focus south;

# swap managed window
cmd + alt - h : yabai -m window --swap west
cmd + alt - l : yabai -m window --swap east
cmd + alt - k : yabai -m window --swap north
cmd + alt - j : yabai -m window --swap south

# move managed window
cmd + ctrl - l : yabai -m window --warp east
cmd + ctrl - h : yabai -m window --warp west
cmd + ctrl - k : yabai -m window --warp north
cmd + ctrl - j : yabai -m window --warp south

# balance size of windows
cmd + shift - 0 : yabai -m space --balance

# make floating window fill screen
# shift + alt - up     : yabai -m window --grid 1:1:0:0:1:1

# make floating window fill left-half of screen
shift + alt - left   : yabai -m window --grid 1:2:0:0:1:1
shift + alt - right  : yabai -m window --grid 1:2:1:0:1:1

# create desktop, move window and follow focus - uses jq for parsing json (brew install jq)
cmd + shift - t : yabai -m space --create && \
                   index="$(yabai -m query --spaces --display | jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
                   yabai -m window --space "${index}" && \
                   yabai -m space --focus "${index}"

# fast focus desktop
	# scripting addion fixes need to be made
#cmd + shift - x : yabai -m space --focus recent
cmd + ctrl - n: yabai -m window --space next; yabai -m window --focus next
cmd + ctrl - p : yabai -m window --space prev; yabai -m window --focus prev
alt + ctrl - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5

# send window to desktop and follow focus
cmd + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
cmd + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
cmd + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
cmd + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
cmd + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5

# focus monitor
cmd + shift - p : yabai -m display --focus prev
cmd + shift - n : yabai -m display --focus next

# send window to monitor and follow focus
cmd + shift - x : yabai -m window --display next; yabai -m display --focus next
cmd + shift - z : yabai -m window --display prev; yabai -m display --focus prev
# ctrl + cmd - 1  : yabai -m window --display 1; yabai -m display --focus 1

# move floating window
# shift + ctrl - a : yabai -m window --move rel:-20:0
# shift + ctrl - s : yabai -m window --move rel:0:20

# window size
cmd + shift - u : yabai -m window --resize left:-50:0; \
				  yabai -m window --resize right:-50:0

cmd + shift - i : yabai -m window --resize right:50:0; \
				  yabai -m window --resize left:50:0;

# set insertion point in focused container
# ctrl + alt - h : yabai -m window --insert west

# toggle window zoom
cmd + shift - d : yabai -m window --toggle zoom-parent
cmd + shift - f : yabai -m window --toggle zoom-fullscreen

# toggle window split type
cmd + shift - e : yabai -m window --toggle split

# float / unfloat window and center on screen
cmd + shift - a : yabai -m window --toggle float;\
          yabai -m window --grid 4:4:1:1:2:2

# toggle sticky(+float), topmost, picture-in-picture
cmd + ctrl + shift - s : yabai -m window --toggle sticky;\
          yabai -m window --toggle topmost;\
          yabai -m window --toggle pip

# restart yabai and skhd and spacebar
cmd + ctrl + shift - r : yabai --restart-service; skhd --restart-service;

cmd + ctrl + shift - s : skhd --restart-service;
cmd + ctrl + shift - y : yabai --restart-service;
cmd + ctrl + shift - return : osascript $HOME/Documents/code/scripts/iterm.scpt
cmd + ctrl + shift - v : osascript $HOME/Documents/code/scripts/itermSplit.scpt v
cmd + ctrl + shift - h : osascript $HOME/Documents/code/scripts/itermSplit.scpt h
cmd + ctrl + shift - 0 : python3 $HOME/Documents/scripts/remarkable.py
