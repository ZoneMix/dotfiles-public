#!/usr/bin/env sh

#SPACEBAR_HEIGHT=$(spacebar -m config height)

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# global settings
yabai -m config \
  mouse_follows_focus off \
  focus_follows_mouse on \
  window_origin_display default \
  window_placement second_child \
  window_zoom_persist on \
  window_shadow on \
  window_animation_duration 0.0 \
  window_animation_frame_rate 120 \
  window_opacity_duration 0.0 \
  active_window_opacity 1.0 \
  normal_window_opacity 1.0 \
  window_opacity on \
  insert_feedback_color 0xffd75f5f \
  split_ratio 0.5 \
  split_type auto \
  auto_balance on \
  top_padding 10 \
  bottom_padding 10 \
  right_padding 10 \
  left_padding 10 \
  window_gap 10 \
  layout bsp \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap \
  external_bar all:0:0

# rules
yabai -m rule --add app="^Ghidra.*" manage=off
yabai -m rule --add app="^Express.*" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add app="^Create" manage=off
yabai -m rule --add app="^VMware Fusion$" manage=off
yabai -m rule --add app="^Finder.*" manage=off
yabai -m rule --add app="^Installation Assistant$" manage=off
yabai -m rule --add app="^Parallels" manage=off
yabai -m rule --add app="^System.*" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^Folder.*" manage=off
yabai -m rule --add app="^Spotify.*" manage=off
yabai -m rule --add app="^Messages.*" manage=off
yabai -m rule --add app="^Wave.*" manage=off
yabai -m rule --add app="^Bitwarden.*" manage=off

echo "yabai configuration loaded.."
